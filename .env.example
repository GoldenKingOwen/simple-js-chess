# ─────────────────────────────────────────────────────────────
# Frontend environment variables
#
# Copy this file to `.env.local` for local development and fill
# in the values. `.env.local` is git-ignored and must NEVER be
# committed.
#
# For the Netlify deployment, add the SAME variables in the
# Netlify dashboard under:
#   Site configuration → Environment variables
# (deploy scope: Production). They are baked into the build, so
# a new deploy is required after changing them.
# ─────────────────────────────────────────────────────────────

# Base URL of the NestJS REST API (e.g. your Render URL). The client
# appends the /api/v1 prefix automatically — do NOT add it here.
# Do NOT commit real URLs — keep them in .env.local / the Netlify dashboard.
NEXT_PUBLIC_API_URL=https://api.example.com

# Base URL of the NestJS Socket.IO gateway. Same host as the
# REST API for this deployment.
NEXT_PUBLIC_SOCKET_URL=https://api.example.com

# Use a comma separated list of socket namespaces if the gateway is namespaced.
# Defaults to the root namespace when empty.
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# Keep the mock layer enabled for local development without the
# backend. Set to "false" (or remove) so the app talks to the
# real API — this is what you want on Netlify.
NEXT_PUBLIC_USE_MOCK_API=false