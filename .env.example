# ─────────────────────────────────────────────────────────────
# Frontend environment variables
#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored and must NEVER be committed.
#
# The production URLs must be set in the Netlify dashboard
# under Site settings → Environment variables.
# ─────────────────────────────────────────────────────────────

# Base URL of the future NestJS REST API.
# When left empty the frontend falls back to the local mock layer.
NEXT_PUBLIC_API_URL=https://api.example.com

# Base URL of the future NestJS Socket.IO gateway.
# Usually the same host as the REST API.
NEXT_PUBLIC_SOCKET_URL=https://api.example.com

# Use a comma separated list of socket namespaces if the gateway is namespaced.
# Defaults to the root namespace when empty.
NEXT_PUBLIC_SOCKET_PATH=/socket.io